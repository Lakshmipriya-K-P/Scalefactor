parser = TraceParser(trace_file)

total_ios = 0

reads = 0
writes = 0
trims = 0
flushes = 0

total_write_sectors = 0

#
# Store WRITE entries
#
write_entries = []


# ======================================================
# Parse Trace
# ======================================================

for io in parser.parse():

    total_ios += 1

    if io.operation in cfg.READ_COMMANDS:

        reads += 1

    elif io.operation in cfg.WRITE_COMMANDS:

        writes += 1

        total_write_sectors += io.size

        write_entries.append(io)

    elif io.operation in cfg.TRIM_COMMANDS:

        trims += 1

    elif io.operation in cfg.FLUSH_COMMANDS:

        flushes += 1


# ======================================================
# Build Sequential Clusters
# ======================================================

clusters = []

current_cluster = []

previous_write = None


for io in write_entries:

    #
    # First write
    #

    if previous_write is None:

        current_cluster = [io]

        previous_write = io

        continue

    #
    # Check whether current write is immediately
    # after previous write
    #

    if io.lba == previous_write.end_lba + 1:

        #
        # Same sequential cluster
        #

        current_cluster.append(io)

    else:

        #
        # Current cluster is complete
        #

        if len(current_cluster) >= 2:

            clusters.append(current_cluster)

        #
        # Start new cluster
        #

        current_cluster = [io]

    previous_write = io


#
# Add final cluster
#

if len(current_cluster) >= 2:

    clusters.append(current_cluster)


# ======================================================
# Cluster Thresholds
# ======================================================

thresholds_kb = [
    4,
    8,
    16,
    32,
    64,
    128
]


# ======================================================
# Analyze Each Threshold
# ======================================================

threshold_results = []


for threshold_kb in thresholds_kb:

    threshold_sectors = (
        threshold_kb * 1024 // cfg.SECTOR_SIZE
    )

    qualifying_clusters = 0

    sequential_write_commands = 0

    sequential_write_sectors = 0


    #
    # Check every sequential cluster
    #

    for cluster in clusters:

        #
        # Calculate total cluster size
        #

        cluster_sectors = sum(
            io.size
            for io in cluster
        )


        #
        # Check threshold
        #

        if cluster_sectors >= threshold_sectors:

            qualifying_clusters += 1

            sequential_write_commands += len(
                cluster
            )

            sequential_write_sectors += (
                cluster_sectors
            )


    # ==================================================
    # Command Percentage
    # ==================================================

    command_percent = (

        sequential_write_commands
        / writes
        * 100

        if writes else 0
    )


    # ==================================================
    # Sector Percentage
    # ==================================================

    sector_percent = (

        sequential_write_sectors
        / total_write_sectors
        * 100

        if total_write_sectors else 0
    )


    threshold_results.append({

        "threshold_kb":
            threshold_kb,

        "threshold_sectors":
            threshold_sectors,

        "clusters":
            qualifying_clusters,

        "seq_write_commands":
            sequential_write_commands,

        "command_percent":
            command_percent,

        "seq_write_sectors":
            sequential_write_sectors,

        "sector_percent":
            sector_percent

    })


# ======================================================
# Other IO Percentages
# ======================================================

read_percent = (

    reads / total_ios * 100

    if total_ios else 0
)

write_percent = (

    writes / total_ios * 100

    if total_ios else 0
)

trim_percent = (

    trims / total_ios * 100

    if total_ios else 0
)

flush_percent = (

    flushes / total_ios * 100

    if total_ios else 0
)


# ======================================================
# Print General Statistics
# ======================================================

print()
print("==============================================")
print(f"Trace : {trace_file}")
print("==============================================")

print(
    f"Total IOs       : "
    f"{total_ios:,}"
)

print(
    f"Reads           : "
    f"{reads:,} ({read_percent:.2f}%)"
)

print(
    f"Writes          : "
    f"{writes:,} ({write_percent:.2f}%)"
)

print(
    f"Trims           : "
    f"{trims:,} ({trim_percent:.2f}%)"
)

print(
    f"Flushes         : "
    f"{flushes:,} ({flush_percent:.2f}%)"
)

print()

print(
    f"Total Write Sectors : "
    f"{total_write_sectors:,}"
)


# ======================================================
# Threshold Analysis
# ======================================================

print()
print("==============================================================")
print(" Sequential Write Threshold Analysis")
print("==============================================================")

print(
    f"{'Threshold':>10} "
    f"{'Clusters':>10} "
    f"{'Seq Cmds':>12} "
    f"{'Cmd %':>10} "
    f"{'Seq Sectors':>15} "
    f"{'Sector %':>10}"
)

print("-" * 72)


for result in threshold_results:

    print(
        f"{result['threshold_kb']:>7} KB "
        f"{result['clusters']:>10,} "
        f"{result['seq_write_commands']:>12,} "
        f"{result['command_percent']:>9.2f}% "
        f"{result['seq_write_sectors']:>15,} "
        f"{result['sector_percent']:>9.2f}%"
    )


print("=" * 72)
